        "format": "handlebars",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"refresh\" content=\"60\">\n    <style>\n        * { box-sizing: border-box; }\n        body {\n            margin: 0; padding: 20px;\n            background: #1a1a1a; \n            font-family: 'Segoe UI', sans-serif;\n            height: 100vh; width: 100vw;\n            display: flex; flex-direction: column;\n            overflow: hidden;\n        }\n        .street-title {\n            text-align: center; font-size: 3em; font-weight: bold;\n            color: white; margin-bottom: 20px; text-transform: uppercase;\n            letter-spacing: 4px; border-bottom: 6px solid #f1c40f;\n            padding-bottom: 10px;\n        }\n        .shopping-street {\n            display: flex; flex-direction: column;\n            gap: 20px; flex: 1;\n        }\n\n        .shop-front {\n            flex: 1; border-radius: 20px;\n            display: flex; flex-direction: column;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n            background: white; border: 4px solid #fff;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .awning { height: 50px; width: 100%; background-size: 50px 100%; }\n        .shop-sign { background: #333; color: #fff; font-size: 1.8em; text-align: center; padding: 8px; font-weight: bold; text-transform: uppercase; }\n        \n        .window-display {\n            padding: 20px; text-align: center; flex: 1;\n            display: flex; flex-direction: column; justify-content: center;\n            position: relative;\n        }\n\n        .icon-bg {\n            position: absolute; top: 50%; left: 50%;\n            transform: translate(-50%, -50%);\n            font-size: 120px; opacity: 0.1; z-index: 0;\n        }\n\n        .article-name { font-size: 2.5em; font-weight: 800; z-index: 1; color: #222; margin: 0; }\n        .message { font-size: 1.5em; color: #444; font-style: italic; z-index: 1; }\n        .price { \n            font-size: 3em; font-weight: 900; z-index: 1;\n            margin-top: 10px; padding: 5px 25px; border-radius: 10px;\n            display: inline-block; align-self: center;\n        }\n        .price::after { content: '€'; font-size: 0.5em; }\n\n        .nav { text-align: center; color: #888; padding: 10px; font-size: 1.2em; }\n    </style>\n</head>\n<body>\n\n    <div class=\"street-title\">Marché des Rhétos</div>\n\n    <div class=\"shopping-street\">\n        {{#payload}}\n        <div class=\"shop-front\" data-article=\"{{Article}}\">\n            <div class=\"awning\"></div>\n            <div class=\"shop-sign\">Boutique {{Article}}</div>\n            <div class=\"window-display\">\n                <div class=\"icon-bg\"></div>\n                <div class=\"article-name\">{{Article}}</div>\n                <div class=\"message\">{{Message}}</div>\n                <div class=\"price\">{{Prix}}</div>\n            </div>\n        </div>\n        {{/payload}}\n    </div>\n\n    <div class=\"nav\">← Journal de l'école | Options →</div>\n\n    <script>\n        window.onload = function() {\n            const themes = {\n                rose: { color: '#ff4d6d', alt: '#ff85a1', icon: '🌹' },\n                lasagne: { color: '#009246', alt: '#ce2b37', icon: '🍝' },\n                oeuf: { color: '#6c5ce7', alt: '#a29bfe', icon: '🥚' },\n                chocolat: { color: '#4e342e', alt: '#795548', icon: '🍫' }\n            };\n\n            const defaultThemes = [\n                { color: '#0984e3', alt: '#74b9ff', icon: '🛍️' },\n                { color: '#e67e22', alt: '#f39c12', icon: '🏷️' },\n                { color: '#27ae60', alt: '#2ecc71', icon: '✨' },\n                { color: '#8e44ad', alt: '#9b59b6', icon: '🎁' },\n                { color: '#d63031', alt: '#ff7675', icon: '🔥' }\n            ];\n\n            const shops = document.querySelectorAll('.shop-front');\n            shops.forEach((shop, index) => {\n                const articleName = shop.getAttribute('data-article').toLowerCase();\n                let style = null;\n\n                // Keyword check\n                if (articleName.includes('rose')) style = themes.rose;\n                else if (articleName.includes('lasagne')) style = themes.lasagne;\n                else if (articleName.includes('oeuf') || articleName.includes('œuf')) style = themes.oeuf;\n                else if (articleName.includes('choc')) style = themes.chocolat;\n\n                // If no keyword, cycle through 5 colorful defaults\n                if (!style) {\n                    style = defaultThemes[index % defaultThemes.length];\n                }\n\n                // Apply styles safely\n                shop.querySelector('.awning').style.backgroundImage = `linear-gradient(90deg, ${style.color} 50%, ${style.alt} 50%)`;\n                shop.querySelector('.shop-sign').style.backgroundColor = style.color;\n                const p = shop.querySelector('.price');\n                p.style.backgroundColor = style.color;\n                p.style.color = 'white';\n                shop.querySelector('.icon-bg').innerText = style.icon;\n            });\n        };\n\n        // Navigation & Auto-Rotate\n        const nextPage = \"/signage4\"; \n        const prevPage = \"/signage2\"; \n        const autoRotation = setInterval(() => { window.location.href = nextPage; }, 10000);\n\n        document.addEventListener('keydown', function(event) {\n            if (event.key === \"ArrowRight\") window.location.href = nextPage;\n            if (event.key === \"ArrowLeft\") window.location.href = prevPage;\n        });\n    </script>\n</body>\n</html>",
