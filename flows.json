    {
        "id": "e61533b76a377a5d",
        "type": "template",
        "z": "c84bd7308b036373",
        "name": "",
        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <style>\n        /* SPRING AESTHETIC - HIGH CONTRAST */\n        * { box-sizing: border-box; }\n        \n        html, body {\n            margin: 0; padding: 0;\n            height: 100%; width: 100%;\n            background: linear-gradient(to bottom, #87ceeb 0%, #e0f7fa 100%);\n            color: #1b3d17; \n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n            overflow: hidden;\n            position: fixed;\n        }\n\n        /* --- ROLLING HILLS --- */\n        .hill {\n            position: fixed;\n            bottom: 0;\n            width: 150%;\n            height: 40vh;\n            background: #7ed957;\n            border-radius: 50% 50% 0 0;\n            z-index: 3;\n        }\n        .hill-back {\n            bottom: -5vh;\n            left: -25%;\n            background: #a2e685;\n            height: 45vh;\n            z-index: 2;\n        }\n\n        /* --- DRIFTING PETALS --- */\n        #petal-container { position: fixed; width: 100%; height: 100%; z-index: 1; }\n        .petal {\n            position: absolute;\n            top: -50px;\n            border-radius: 150% 0 150% 0;\n            opacity: 0.6;\n            animation: fall linear infinite;\n        }\n        @keyframes fall {\n            0% { transform: translateY(0) translateX(0) rotate(0deg); opacity: 0; }\n            10% { opacity: 0.8; }\n            100% { transform: translateY(110vh) translateX(100px) rotate(360deg); opacity: 0; }\n        }\n\n        /* --- THE STATIONARY BEE (Bottom Right) --- */\n        #bee-box {\n            position: fixed;\n            bottom: 40px;\n            right: 40px;\n            display: flex;\n            align-items: center;\n            z-index: 100;\n            animation: hover 3s infinite ease-in-out;\n        }\n        @keyframes hover {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-20px); }\n        }\n        #bee-emoji {\n            font-size: 120px;\n            filter: drop-shadow(0 8px 15px rgba(0,0,0,0.2));\n            transform: scaleX(-1); /* Facing left */\n        }\n        #chat-bubble {\n            background: white;\n            color: #d4a017;\n            padding: 15px 25px;\n            border-radius: 25px 25px 5px 25px;\n            font-weight: bold;\n            font-size: 1.8rem;\n            position: absolute;\n            top: -70px; right: 100px;\n            white-space: nowrap;\n            box-shadow: 0 10px 25px rgba(0,0,0,0.1);\n            border: 3px solid #fff9c4;\n        }\n\n        /* --- UI LAYER & TEXT SHADOWING --- */\n        .ui-layer {\n            position: relative;\n            height: 100%; width: 100%;\n            display: flex; \n            flex-direction: column;\n            align-items: center; \n            justify-content: center;\n            text-align: center;\n            z-index: 10; \n            gap: 40px;\n        }\n        \n        h1 { \n            font-size: 8rem; \n            margin: 0; \n            color: #ffffff; \n            /* Heavy shadow for maximum visibility */\n            text-shadow: \n                4px 4px 0px rgba(0,0,0,0.1),\n                0px 0px 30px rgba(45, 90, 39, 0.6);\n            letter-spacing: 8px;\n            font-weight: 900;\n            line-height: 1;\n        }\n\n        .credit-text { \n            color: #ffffff; \n            font-size: 3.5rem; \n            font-weight: 700;\n            background: rgba(45, 90, 39, 0.7); /* Darker background for contrast */\n            padding: 10px 60px;\n            border-radius: 100px;\n            backdrop-filter: blur(10px);\n            text-shadow: 2px 2px 10px rgba(0,0,0,0.3);\n            border: 2px solid rgba(255,255,255,0.3);\n        }\n\n        /* --- QR SECTION --- */\n        .qr-bubble {\n            flex-shrink: 0;\n            width: 500px; \n            height: 500px;\n            background: rgba(255, 255, 255, 0.9); /* Higher opacity */\n            backdrop-filter: blur(10px);\n            border: 12px solid #ffffff;\n            border-radius: 60px;\n            display: flex; \n            flex-direction: column;\n            align-items: center; \n            justify-content: center;\n            box-shadow: 0 30px 60px rgba(0,0,0,0.15);\n        }\n\n        .qr-bubble img { \n            width: 320px; \n            height: 320px; \n            border-radius: 10px; \n        }\n\n        .qr-label {\n            margin-top: 20px; \n            font-weight: 900; \n            color: #2d5a27;\n            font-size: 2.8rem;\n            text-shadow: none; /* Keep clean for scanning focus */\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"hill hill-back\"></div>\n    <div class=\"hill\"></div>\n    <div id=\"petal-container\"></div>\n\n    <div id=\"bee-box\">\n        <div id=\"chat-bubble\">C'est moi qui l'ai fait ! 🌸</div>\n        <div id=\"bee-emoji\">🐝</div>\n    </div>\n\n    <div class=\"ui-layer\">\n        <h1>P4TH SIGNAGE</h1>\n        <div class=\"credit-text\">Projet réalisé par Leilah Q.</div>\n        <div class=\"qr-bubble\">\n            <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=500x500&data=https://www.p4th.be\">\n            <div class=\"qr-label\">P4TH.BE</div>\n        </div>\n    </div>\n\n    <script>\n        // PETALS LOGIC\n        const pCont = document.getElementById('petal-container');\n        for (let i = 0; i < 40; i++) {\n            const p = document.createElement('div');\n            p.className = 'petal';\n            const size = Math.random() * 15 + 10 + 'px';\n            p.style.width = size; \n            p.style.height = size;\n            p.style.left = Math.random() * 100 + 'vw';\n            p.style.animationDuration = (Math.random() * 5 + 5) + 's';\n            p.style.animationDelay = Math.random() * 8 + 's';\n            p.style.background = ['#ffc0cb', '#ffb7c5', '#ffffff'][Math.floor(Math.random() * 3)];\n            pCont.appendChild(p);\n        }\n\n        /// Navigation targets\n        const nextPage = \"/signage1\"; \n        const prevPage = \"/signage4\"; \n        const waitTime = 10000; \n\n        const autoRotation = setInterval(() => { window.location.href = nextPage; }, waitTime);\n\n        document.addEventListener('keydown', function(event) {\n            if (event.key === \"ArrowRight\") { window.location.href = nextPage; } \n            else if (event.key === \"ArrowLeft\") { window.location.href = prevPage; }\n        });\n    </script>\n</body>\n</html>",
