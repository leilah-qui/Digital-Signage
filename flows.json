        "template": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"refresh\" content=\"60\">\n    <style>\n        * { box-sizing: border-box; }\n        \n        body { \n            margin: 0; padding: 0;\n            background-color: #ffffff;\n            background-image: radial-gradient(#ddd 1px, transparent 1px);\n            background-size: 24px 24px;\n            color: #000; \n            font-family: \"Comic Sans MS\", \"Comic Sans\", cursive; \n            display: flex; flex-direction: column;\n            height: 100vh; width: 100vw;\n            overflow: hidden; \n        }\n\n        header {\n            padding: 40px;\n            background: #ff0000;\n            border-bottom: 10px solid #000;\n            transform: skewY(-1.5deg);\n            margin-top: -15px;\n            box-shadow: 15px 15px 0 #000;\n            z-index: 10;\n        }\n\n        h1 { \n            font-size: 85px; margin: 0;\n            color: white;\n            text-shadow: 8px 8px 0 #000;\n            text-transform: uppercase;\n            -webkit-text-stroke: 3px black;\n        }\n\n        main {\n            flex: 1;\n            padding: 60px 40px;\n            display: flex;\n            flex-direction: column;\n            gap: 35px;\n        }\n\n        .prof-row {\n            background: #fff;\n            border: 8px solid #000;\n            padding: 30px;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            position: relative;\n            box-shadow: 15px 15px 0 rgba(0,0,0,0.2);\n        }\n\n        .info-block {\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n            max-width: 60%;\n        }\n\n        .prof-name {\n            font-size: 60px;\n            font-weight: 900;\n            text-transform: uppercase;\n            line-height: 0.9;\n        }\n\n        .prof-desc {\n            font-size: 28px;\n            font-weight: bold;\n            color: #000;\n            background: #ffffff;\n            padding: 5px 15px;\n            border: 3px solid #000;\n            display: inline-block;\n            box-shadow: 4px 4px 0 #000;\n        }\n\n        /* --- THE STATUS BUBBLE FIX --- */\n        .status-box {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            min-width: 250px; /* Ensures space for \"Greviste\" */\n        }\n\n        .status-bubble {\n            background: #fff;\n            color: #000; /* Forces black text visibility */\n            border: 6px solid #000;\n            padding: 15px 30px;\n            border-radius: 60px;\n            font-size: 42px;\n            font-weight: 900;\n            text-transform: uppercase;\n            text-align: center;\n            width: 100%;\n            display: block; /* Ensures it renders as a box */\n        }\n\n        /* DYNAMIC COLORS - Lowercase to be safe */\n        .row-absent { background-color: #ffeb3b; }\n        .row-retard { background-color: #ff9800; }\n        .row-greviste { background-color: #f44336; } \n\n        /* Ensure text stays visible on Red background */\n        .row-greviste .prof-name { color: #fff; text-shadow: 4px 4px 0 #000; }\n        .row-greviste .status-bubble { background: #000; color: #fff; border-color: #fff; }\n\n    </style>\n</head>\n<body>\n\n    <header>\n        <h1>ATTENDANCE DES PROFS</h1>\n    </header>\n\n    <main>\n        {{#payload}}\n        <div class=\"prof-row row-{{STATUS}}\">\n            \n            <div class=\"info-block\">\n                <div class=\"prof-name\">{{PROF}}</div>\n                <div class=\"prof-desc\">{{DESC}}</div>\n            </div>\n\n            <div class=\"status-box\">\n                <div class=\"status-bubble\">\n                    {{STATUS}}\n                </div>\n            </div>\n\n        </div>\n        {{/payload}}\n    </main>\n\n    <footer style=\"padding: 20px 40px; background: #000; color: #fff; display: flex; justify-content: space-between; font-size: 25px; font-weight: bold;\">\n        <span><<< PRÉCÉDENT</span>\n        <span style=\"color: #ffeb3b;\">PAGE 1 / 4</span>\n        <span>SUIVANT >>></span>\n    </footer>\n\n    <script>\n        const nextPage = \"/signage2\"; \n        const prevPage = \"/signage5\"; \n        \n        // Auto-rotation\n        setInterval(() => { window.location.href = nextPage; }, 12000);\n\n        // Manual Nav\n        document.addEventListener('keydown', (e) => {\n            if (e.key === \"ArrowRight\") window.location.href = nextPage;\n            if (e.key === \"ArrowLeft\") window.location.href = prevPage;\n        });\n    </script>\n</body>\n</html>",
