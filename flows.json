        "template": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"refresh\" content=\"20\">\n    <style>\n        /* VERTICAL RESET */\n        * { box-sizing: border-box; }\n        \n        body { \n            margin: 0; \n            padding: 40px; \n            background-color: #f4f1ea; /* Paper texture */\n            color: #1a1a1a; \n            font-family: 'Times New Roman', serif; \n            height: 100vh;\n            width: 100vw;\n            display: flex;\n            flex-direction: column;\n            overflow: hidden;\n        }\n\n        /* TALL HEADER */\n        .news-header { \n            text-align: center; \n            border-bottom: 8px double #1a1a1a; \n            border-top: 8px double #1a1a1a; \n            padding: 20px 0; \n            margin-bottom: 40px; \n        }\n\n        h1 { \n            font-size: 70px; /* Scaled up for portrait */\n            text-transform: uppercase; \n            margin: 0; \n            letter-spacing: -2px; \n        }\n\n        .header-meta {\n            display: flex; \n            justify-content: space-between; \n            font-weight: bold;\n            font-size: 20px;\n            margin-top: 10px;\n        }\n\n        /* VERTICAL COLUMN LAYOUT */\n        .news-stack { \n            flex: 1;\n            display: flex; \n            flex-direction: column; \n            gap: 50px; /* Space between vertical articles */\n        }\n\n        .article { \n            border-bottom: 1px solid #aaa; /* Bottom border instead of side */\n            padding-bottom: 30px; \n            width: 100%;\n        }\n\n        .article:last-child { border-bottom: none; }\n\n        .headline { \n            font-size: 45px; /* Larger for easy reading */\n            font-weight: bold; \n            text-decoration: underline; \n            margin-bottom: 10px; \n            display: block;\n            line-height: 1.1;\n        }\n\n        .meta { \n            font-style: italic; \n            color: #444; \n            margin-bottom: 15px; \n            display: block; \n            font-size: 24px; \n        }\n\n        .content { \n            font-size: 26px; \n            line-height: 1.4; \n            margin: 0;\n            text-align: justify;\n        }\n\n        /* PORTRAIT NAVIGATION HINT */\n        .nav-hint {\n            text-align: center;\n            font-size: 18px;\n            color: #888;\n            padding-top: 20px;\n            border-top: 1px solid #ccc;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"news-header\">\n        <h1>JOURNAL DE L'ÉCOLE</h1>\n        <div class=\"header-meta\">\n            <span>VOL. 26 NO. 3</span>\n            <span>ÉVÉNEMENTS SCOLAIRES</span>\n            <span>PAGE 2 / 4</span>\n        </div>\n    </div>\n\n    <div class=\"news-stack\">\n        {{#payload}}\n        <div class=\"article\">\n            <span class=\"headline\">{{EVENT}}</span>\n            <span class=\"meta\">📍 {{LIEU}} | 📅 {{DATE}}</span>\n            <p class=\"content\">{{DESCRIPTION}}</p>\n        </div>\n        {{/payload}}\n    </div>\n\n    <div class=\"nav-hint\">Appuyez sur ← ou → pour naviguer</div>\n\n    <script>\n    // 1. CONFIGURATION: Set your navigation targets here\n    const nextPage = \"/signage3\"; // CHANGE THIS per page (e.g. /signage3, /signage4...)\n    const prevPage = \"/signage1\"; // CHANGE THIS per page\n    const waitTime = 10000;       // 10 seconds in milliseconds\n\n    // 2. THE AUTOMATIC TIMER\n    // This will trigger the nextPage function after 10 seconds of no activity\n    const autoRotation = setInterval(() => {\n        window.location.href = nextPage;\n    }, waitTime);\n\n    // 3. MANUAL NAVIGATION (Arrows)\n    document.addEventListener('keydown', function(event) {\n        if (event.key === \"ArrowRight\") {\n            clearInterval(autoRotation); // Stop the timer if they click\n            window.location.href = nextPage;\n        } \n        else if (event.key === \"ArrowLeft\") {\n            clearInterval(autoRotation); // Stop the timer if they click\n            window.location.href = prevPage;\n        }\n    });\n</script>\n</body>\n</html>",
