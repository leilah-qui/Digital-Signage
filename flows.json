        "id": "35a4da8929b86268",
        "type": "template",
        "z": "c84bd7308b036373",
        "name": "",
        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"refresh\" content=\"30\">\n    <style>\n        * { box-sizing: border-box; }\n        \n        body {\n            margin: 0; padding: 40px;\n            background: #ffffff;\n            color: #000; \n            font-family: \"Comic Sans MS\", \"Comic Sans\", cursive;\n            height: 100vh; width: 100vw;\n            display: flex; flex-direction: column;\n            overflow: hidden;\n        }\n\n        .header { \n            text-align: center; font-size: 5em; margin-bottom: 30px; \n            font-weight: 900; border-bottom: 10px solid #000;\n            padding-bottom: 10px; transform: rotate(-1deg);\n        }\n        \n        .options-wrapper {\n            display: flex; flex-direction: column; gap: 25px; flex: 1;\n        }\n\n        .card {\n            flex: 1; border: 6px solid #000; padding: 30px;\n            display: flex; flex-direction: column; justify-content: center;\n            position: relative; overflow: hidden;\n            box-shadow: 12px 12px 0px #000;\n            background: white;\n            z-index: 1;\n        }\n\n        /* --- SCIENCE FORT: BUBBLES --- */\n        [id*=\"Science Fort\"] { background-color: #99ff99; }\n        .bubble {\n            position: absolute; background: rgba(255,255,255,0.4);\n            border: 2px solid #000; border-radius: 50%;\n            bottom: -50px; animation: rise 4s infinite ease-in;\n            z-index: -1;\n        }\n        @keyframes rise {\n            0% { transform: translateY(0) scale(1); opacity: 1; }\n            100% { transform: translateY(-400px) scale(1.5); opacity: 0; }\n        }\n\n        /* --- SCIENCE ECO: RAINING MONEY --- */\n        [id*=\"Eco\"] { background-color: #ffff66; }\n        .money {\n            position: absolute; font-size: 40px; font-weight: bold;\n            top: -50px; animation: rain 3s infinite linear;\n            z-index: -1; color: #2ecc71;\n            text-shadow: 2px 2px 0 #000;\n        }\n        @keyframes rain {\n            0% { transform: translateY(0) rotate(0deg); }\n            100% { transform: translateY(600px) rotate(360deg); }\n        }\n\n        /* --- INFORMATIQUE: GLOWING HACKER THEME --- */\n        [id*=\"Informatique\"], [id*=\"IT\"] { \n            background-color: #000; \n            color: #00ff41; \n            border-color: #00ff41;\n            box-shadow: 12px 12px 0px #003300;\n        }\n        \n        [id*=\"Informatique\"] .title, [id*=\"IT\"] .title {\n            color: #00ff41;\n            text-shadow: 0 0 10px #00ff41, 0 0 20px #00ff41;\n            animation: glow 1.5s ease-in-out infinite alternate;\n        }\n\n        [id*=\"Informatique\"] .desc, [id*=\"IT\"] .desc { \n            color: #00ff41; \n            font-family: 'Courier New', monospace; \n            text-shadow: 0 0 5px #00ff41;\n        }\n\n        /* The falling code particles */\n        .code-bit {\n            position: absolute; color: #003300; font-family: monospace;\n            font-size: 20px; top: -20px; z-index: -1;\n            animation: fall 2s infinite linear;\n        }\n\n        @keyframes glow {\n            from { text-shadow: 0 0 10px #00ff41, 0 0 20px #00ff41; }\n            to { text-shadow: 0 0 20px #00ff41, 0 0 40px #00ff41, 0 0 10px #fff; }\n        }\n\n        @keyframes fall {\n            to { transform: translateY(500px); opacity: 0; }\n        }\n\n        .cursor { animation: blink 0.8s infinite; }\n        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }\n\n        /* General UI Styles */\n        .title { font-size: 3.5em; font-weight: 900; margin: 0; text-transform: uppercase; z-index: 2; }\n        .hours { \n            font-size: 1.5em; background: #000; color: #fff;\n            padding: 5px 20px; width: fit-content; margin-bottom: 10px; z-index: 2;\n            border: 2px solid currentColor;\n        }\n        .desc { font-size: 1.8em; line-height: 1.2; max-width: 80%; font-weight: bold; z-index: 2; }\n        .nav { padding-top: 30px; text-align: center; font-weight: 900; font-size: 1.5em; }\n    </style>\n</head>\n<body>\n\n    <div class=\"header\">NOS OPTIONS</div>\n\n    <div class=\"options-wrapper\">\n        {{#payload}}\n        <div class=\"card\" id=\"{{OPTION}}\">\n            <div class=\"hours\">{{HEURES}} HEURES</div>\n            <div class=\"title\">{{OPTION}} <span class=\"cursor\">_</span></div>\n            <div class=\"desc\">{{DESCRIPTION}}</div>\n        </div>\n        {{/payload}}\n    </div>\n\n    <div class=\"nav\">← PROFS | ACCUEIL →</div>\n\n    <script>\n        document.querySelectorAll('.card').forEach(card => {\n            const id = card.id.toLowerCase();\n            \n            // SCIENCE FORT: Bubbles\n            if (id.includes('science fort')) {\n                for(let i=0; i<12; i++) {\n                    let b = document.createElement('div');\n                    b.className = 'bubble';\n                    b.style.left = Math.random() * 100 + '%';\n                    b.style.width = b.style.height = Math.random() * 40 + 20 + 'px';\n                    b.style.animationDelay = Math.random() * 4 + 's';\n                    card.appendChild(b);\n                }\n            }\n            \n            // ECO: Raining Money\n            if (id.includes('eco')) {\n                for(let i=0; i<10; i++) {\n                    let m = document.createElement('div');\n                    m.className = 'money';\n                    m.innerText = '$';\n                    m.style.left = Math.random() * 100 + '%';\n                    m.style.animationDelay = Math.random() * 3 + 's';\n                    card.appendChild(m);\n                }\n            }\n\n            // INFORMATIQUE: Falling Numbers/Binary\n            if (id.includes('informatique') || id.includes('it')) {\n                for(let i=0; i<20; i++) {\n                    let c = document.createElement('div');\n                    c.className = 'code-bit';\n                    c.innerText = Math.round(Math.random()); // Random 0 or 1\n                    c.style.left = Math.random() * 100 + '%';\n                    c.style.animationDuration = (Math.random() * 2 + 1) + 's';\n                    c.style.animationDelay = Math.random() * 2 + 's';\n                    card.appendChild(c);\n                }\n            }\n        });\n\n        // Navigation targets\n        const nextPage = \"/signage5\"; \n        const prevPage = \"/signage3\"; \n        const waitTime = 10000; \n\n        const autoRotation = setInterval(() => { window.location.href = nextPage; }, waitTime);\n\n        document.addEventListener('keydown', function(event) {\n            if (event.key === \"ArrowRight\") { window.location.href = nextPage; } \n            else if (event.key === \"ArrowLeft\") { window.location.href = prevPage; }\n        });\n    </script>\n</body>\n</html>",
